# Copy to server/.env. Never commit a filled-in copy.
NODE_ENV=development
PORT=4000
# Must point at a replica set — transactions are required and a standalone mongod cannot do them.
# Local: mongod --replSet rs0, then rs.initiate() once.
MONGODB_URI=mongodb://127.0.0.1:27017/fieldops?replicaSet=rs0

# IANA timezone for the business day. Assignment.date is a plain YYYY-MM-DD in this zone.
OPERATING_TIMEZONE=Asia/Kolkata
CORS_ORIGIN=http://localhost:5173
